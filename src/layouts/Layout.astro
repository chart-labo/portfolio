---
import { ClientRouter } from 'astro:transitions';
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
	</head>
	<body>
		<audio id="global-bgm" src="/music/今日の空も.mp3" loop transition:persist></audio>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/works">Works</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer></footer>
	</body>
</html>

<style>
	/* 画面全体の背景画像・ピクセル描画適用 */
	html {
		background-image: url('/images/星空.png'); /* publicフォルダ内の画像パス */
		background-size: cover;
		background-position: center;
		background-attachment: fixed; /* スクロールしても背景を固定 */
		background-repeat: no-repeat;
		min-height: 100vh;

		/* ドット絵の輪郭をくっきりさせる設定 */
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	/* サイト内のすべての画像・イラストにも適用する場合 */
	img, canvas {
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	body {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		font-family: "DotGothic16", sans-serif;
		line-height: 1.8;
		color: #333;
	}

	nav {
		display: flex;
		gap: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
	}

	nav a {
		color: #449be2;
		text-decoration: none;
		transition: color 0.2s ease;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
	}

	nav a:hover {
		color: #245fac;
	}

	main {
		background-color: rgba(255, 255, 255, 0.85);
		color: #414170;
		border-radius: 12px;
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
		padding: 2rem;
		margin-top: 1.5rem;
	}

	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		font-size: 0.85rem;
		color: #888;
	}
</style>