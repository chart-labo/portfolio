---
import Layout from '../layouts/Layout.astro';
import Bgm from '../layouts/bgm.layout.astro';

const nameText = "Works";
const charCount = nameText.length;
---
<Bgm/>
<Layout title="Works | チャートのホームページ">
	<h1 class="works" style={`--char-count: ${charCount};`}>{nameText}</h1>
	<ul>
		<li>
			<strong>このホームページ</strong> — Astroで作りました
		</li>
		<li>
            
		</li>
	</ul>
    
</Layout>
<style>
	.video-wrapper iframe {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 8px;
		border: none;
	}
	
.works {
    font-size: 2rem;
    overflow: hidden; /* はみ出たテキストを隠す */
    white-space: nowrap; /* 自動改行を無効化 */
    border-right: 3px solid #414170; /* カーソル線 */
    width: 0;
    
    /* アニメーション指定 */
    animation: 
      typing 1.0s steps(var(--char-count)) forwards,
      blink-cursor 1.0s step-end infinite;
  }

  /* テキストを徐々に広げる */
  @keyframes typing {
    from { width: 0; }
    to { width: calc(var(--char-count) * 1ch); } /* 1ch = 1文字の幅 */
  }

  /* カーソルを点滅させる */
  @keyframes blink-cursor {
    from, to { border-color: transparent; }
    50% { border-color: #414170; }
  }
</style>