---
import Layout from '../layouts/Layout.astro';
import Bgm from '../layouts/bgm.layout.astro';

const nameText = "Works";
---
<Bgm/>
<Layout title="Works | チャートのホームページ">
	{/* JSで1文字ずつ表示する h1 */}
	<h1 class="works" data-text={nameText} data-speed="200">
		<span class="text"></span><span class="cursor">_</span>
	</h1>

	<ul>
		<li>
			<strong>このホームページ</strong> — Astroで作りました
		</li>
		<li>
            
		</li>
	</ul>
</Layout>

{/* タイピング用スクリプト */}
<script>
  function initTypewriter() {
    const elements = document.querySelectorAll<HTMLElement>('.works');

    elements.forEach((el) => {
      const text = el.dataset.text || '';
      const speed = parseInt(el.dataset.speed || '200', 10);
      const textEl = el.querySelector('.text');

      if (!textEl) return;

      let index = 0;
      textEl.textContent = '';

      function type() {
        if (index < text.length) {
          textEl.textContent += text.charAt(index);
          index++;
          setTimeout(type, speed);
        }
      }

      type();
    });
  }

  // 初期読み込み＆ページ遷移時の両方で再実行
  initTypewriter();
  document.addEventListener('astro:page-load', initTypewriter);
</script>

<style>
	.video-wrapper iframe {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 8px;
		border: none;
	}
	
	/* タイピング表示ヘッダー */
	.works {
		font-size: 2rem;
		color: #414170;
		margin-top: 0;
		margin-bottom: 1.2rem;
	}

	/* アンダーバー _ カーソルの点滅 */
	.cursor {
		display: inline-block;
		margin-left: 2px;
		color: #414170;
		animation: blink 0.8s infinite;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}
</style>