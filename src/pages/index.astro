---
import Layout from '../layouts/Layout.astro';
---

<Layout title="チャートのホームページ">
  <!-- 1. オープニング画面（画面全体をクリック待ちにする幕） -->
  <div id="opening-overlay">
    <div class="star-wrapper">
      <img src="/images/star.png" class="hero-star" alt="" />
      <div class="star-text">
        <p>This website <br> plays music.</p>
        <span class="click-hint">start!</span>
      </div>
    </div>
  </div>

  <div class="start">
    <h1> ⋆⭒˚｡ Explore Chart's orbit ⋆⭒˚｡ </h1>
    <p>-Welcome to Chart's homepage-</p>
  </div>
    <div class="moon-card">
      <span class="icon" id="moon-icon">🌑</span>
      <h2>今夜の月は…<span id="moon-name">...</span></h2>
      <p id="moon-text">読み込み中...</p>
    </div>

</Layout>

<script>
  function setupOpening() {
    const overlay = document.getElementById('opening-overlay');
    const bgm = document.getElementById('global-bgm') as HTMLAudioElement;

    if (!overlay) return;

    // 1. フラグの確認
    const hasVisited = sessionStorage.getItem('hasVisitedWelcome');

    if (hasVisited) {
      // 訪問済みの場合はCSSクラスを付与して即座に非表示
      overlay.classList.add('is-visited');
    } else {
      // 初回訪問時：クリックイベントを設定
      overlay.addEventListener('click', () => {
        if (bgm) bgm.play().catch(() => {});
        overlay.classList.add('hide');
        sessionStorage.setItem('hasVisitedWelcome', 'true');
      });
    }
  }

  // 月の計算処理
  function setupMoon() {
    function getMoonPhase(date = new Date()) {
      const cycle = 29.5305882;
      const knownNewMoon = new Date('2000-01-06T18:14:00Z');
      const diffDays = (date.getTime() - knownNewMoon.getTime()) / (1000 * 60 * 60 * 24);
      const phase = (diffDays % cycle) / cycle;
      return phase < 0 ? phase + 1 : phase;
    }

    function getMoonData(p: number) {
      if (p < 0.03 || p >= 0.97) return { name: '新月', icon: '🌑', text: '今日は新月です' };
      if (p < 0.22) return { name: '三日月！', icon: '🌒', text: '綺麗な三日月です' };
      if (p < 0.28) return { name: '上弦の月！', icon: '🌓', text: '今日は上弦の月！' };
      if (p < 0.47) return { name: '満月間近！', icon: '🌔', text: 'もう少しで満月です' };
      if (p < 0.53) return { name: '満月！', icon: '🌕', text: '今日は満月です！' };
      if (p < 0.72) return { name: '満月過ぎ！', icon: '🌖', text: '少しずつ欠けていきます' };
      if (p < 0.78) return { name: '下弦の月！', icon: '🌗', text: '今日は下弦の月！' };
      return { name: '有明の月！', icon: '🌘', text: '新月に近づいています' };
    }

    const phase = getMoonPhase();
    const moon = getMoonData(phase);

    const iconEl = document.getElementById('moon-icon');
    const nameEl = document.getElementById('moon-name');
    const textEl = document.getElementById('moon-text');

    if (iconEl) iconEl.textContent = moon.icon;
    if (nameEl) nameEl.textContent = moon.name;
    if (textEl) textEl.textContent = moon.text;
  }

  // 初回読み込み ＆ Astroのページ遷移時に両方実行
  document.addEventListener('astro:page-load', () => {
    setupOpening();
    setupMoon();
  });

  // ClientRouterを使っていない通常のMPA遷移用フォールバック
  setupOpening();
  setupMoon();
</script>

<style>
  /* --- オープニング幕（全画面） --- */
  #opening-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #201b6d; /* 暗い夜空のような背景色 */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 99999;
    cursor: pointer; /* クリックできることを提示 */
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  /* クリックされたらフェードアウトして消える */
  #opening-overlay.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 星とテキストを包む枠（右上から中央へ移動） */
  .star-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: starArrive 1.2s ease-out forwards;
  }

  /* 流れ星画像 */
  .hero-star {
    width: 500px; /* 文字が入る大きめサイズ */
    height: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 12px rgba(255, 230, 120, 0.5));
  }

  /* 星の上に重ねるメッセージ文字とボタン */
  /* 文字とボタンを囲む親グループ */
  .star-text {
    position: absolute;
    top: 32%;          /* 上下の位置 */
    left: 19%;         /* 左右の位置 */
    max-width: 110px;

    /* 縦並び ＆ 中央寄せ */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;          /* ★文字とボタンの隙間（ここを自由に調整！） */

    pointer-events: none;
    user-select: none;
  }

  /* 文字（<p>タグの勝手な余白を消す） */
  .star-text p {
    margin: 7px 0 0 0;      
    color: #30096e;
    font-weight: bold;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  /* クリックボタン（margin-top は消してOK） */
  .click-hint {
    display: inline-block;
    font-size: 10px;
    background: #faeb64;
    color: #30096e;
    padding: 4px 10px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    animation: pulse 1.5s infinite;

    position: relative;
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .click-hint:hover {
    animation-play-state: paused;
    background:  #30096e;           /* ホバー時の背景色（例：白） */
    color: #faeb64;                 /* ホバー時の文字色 */
    transform: scale(1.1);          /* 少し大きくする */
  }

  /* 右上から流れてきて中央でピタッと止まる */
  @keyframes starArrive {
    0% {
      transform: translate(60vw, -60vh) scale(0.3) rotate(-30deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  /* ヒント文字のフワフワ点滅 */
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.95); opacity: 0.7; }
  }
  /* 訪問済みの場合はCSSレベルで画面から消す */
 #opening-overlay.is-visited {
  display: none !important;
 }

 .start{
		background-color: rgba(214, 228, 255, 0.8);
		color: #414170;
		border-radius: 12px;
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
		padding: 2rem;
		margin-top: 1.5rem;
    text-align: center;
    margin-bottom: 2.5rem;
	}
</style>