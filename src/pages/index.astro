---
import { ClientRouter } from 'astro:transitions';
const { title = "チャートのホームページ" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&family=DotGothic16&display=swap" rel="stylesheet" />
	</head>
	<body>
		<audio id="global-bgm" src="/music/今日の空も.mp3" loop transition:persist></audio>
		
		<!-- オープニング画面 -->
		<div id="opening-overlay">
			<div class="star-wrapper">
				<img src="/images/star.png" class="hero-star" alt="" />
				<div class="star-text">
					<p>This website <br> plays music.</p>
					<span class="click-hint">start!</span>
				</div>
			</div>
		</div>

		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/works">Works</a>
				<a href="/links">Links</a>
			</nav>
		</header>

		<!-- 1つ目の白い半透明の枠 -->
		<div class="content-frame top-frame">
			<div class="start">
				<h1> ⋆⭒˚｡ Explore Chart's orbit ⋆⭒˚｡ </h1>
				<p>-Welcome to Chart's homepage-</p>
			</div>
		</div>

		<!-- 2つ目の白い半透明の枠 -->
		<div class="content-frame bottom-frame">
			<div class="moon-card">
				<span class="icon" id="moon-icon">🌑</span>
				<h2>今夜の月は…<span id="moon-name">...</span></h2>
				<p id="moon-text">読み込み中...</p>
			</div>

			<slot />
		</div>

		<footer></footer>
	</body>
</html>

<script>
  function setupOpening() {
    const overlay = document.getElementById('opening-overlay');
    const bgm = document.getElementById('global-bgm') as HTMLAudioElement;

    if (!overlay) return;

    const hasVisited = sessionStorage.getItem('hasVisitedWelcome');

    if (hasVisited) {
      overlay.classList.add('is-visited');
    } else {
      overlay.addEventListener('click', () => {
        if (bgm) bgm.play().catch(() => {});
        overlay.classList.add('hide');
        sessionStorage.setItem('hasVisitedWelcome', 'true');
      });
    }
  }

  function setupMoon() {
    function getMoonPhase(date = new Date()) {
      const cycle = 29.5305882;
      const knownNewMoon = new Date('2000-01-06T18:14:00Z');
      const diffDays = (date.getTime() - knownNewMoon.getTime()) / (1000 * 60 * 60 * 24);
      const phase = (diffDays % cycle) / cycle;
      return phase < 0 ? phase + 1 : phase;
    }

    function getMoonData(p: number) {
      if (p < 0.03 || p >= 0.97) return { name: '新月', icon: '🌑', text: '今日は新月です' };
      if (p < 0.22) return { name: '三日月！', icon: '🌒', text: '綺麗な三日月です' };
      if (p < 0.28) return { name: '上弦の月！', icon: '🌓', text: '今日は上弦の月！' };
      if (p < 0.47) return { name: '満月間近！', icon: '🌔', text: 'もう少しで満月です' };
      if (p < 0.53) return { name: '満月！', icon: '🌕', text: '今日は満月です！' };
      if (p < 0.72) return { name: '満月過ぎ！', icon: '🌖', text: '少しずつ欠けていきます' };
      if (p < 0.78) return { name: '下弦の月！', icon: '🌗', text: '今日は下弦の月！' };
      return { name: '有明の月！', icon: '🌘', text: '新月に近づいています' };
    }

    const phase = getMoonPhase();
    const moon = getMoonData(phase);

    const iconEl = document.getElementById('moon-icon');
    const nameEl = document.getElementById('moon-name');
    const textEl = document.getElementById('moon-text');

    if (iconEl) iconEl.textContent = moon.icon;
    if (nameEl) nameEl.textContent = moon.name;
    if (textEl) textEl.textContent = moon.text;
  }

  document.addEventListener('astro:page-load', () => {
    setupOpening();
    setupMoon();
  });

  setupOpening();
  setupMoon();
</script>

<style>
  /* --- オープニング幕（全画面） --- */
  #opening-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #201b6d;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 99999;
    cursor: pointer;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  #opening-overlay.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .star-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: starArrive 1.2s ease-out forwards;
  }

  .hero-star {
    width: 500px;
    height: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 12px rgba(255, 230, 120, 0.5));
  }

  .star-text {
    position: absolute;
    top: 32%;
    left: 19%;
    max-width: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    pointer-events: none;
    user-select: none;
  }

  .star-text p {
    margin: 7px 0 0 0;
    color: #30096e;
    font-weight: bold;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  .click-hint {
    display: inline-block;
    font-size: 10px;
    background: #faeb64;
    color: #30096e;
    padding: 4px 10px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    animation: pulse 1.5s infinite;
    position: relative;
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .click-hint:hover {
    animation-play-state: paused;
    background: #30096e;
    color: #faeb64;
    transform: scale(1.1);
  }

  @keyframes starArrive {
    0% {
      transform: translate(60vw, -60vh) scale(0.3) rotate(-30deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.95); opacity: 0.7; }
  }

  #opening-overlay.is-visited {
    display: none !important;
  }

  html {
    background-image: url('/images/星空.png');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    min-height: 100vh;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  body {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    font-family: "DotGothic16", sans-serif;
    line-height: 1.8;
    color: #333;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }

  nav a {
    color: #449be2;
    text-decoration: none;
    transition: color 0.2s ease;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  nav a:hover {
    color: #245fac;
  }

  /* .content-frame (元のmainスタイルを継承) */
  .content-frame {
    background-color: rgba(255, 255, 255, 0.80);
    color: #414170;
    border-radius: 12px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
    padding: 2rem;
    margin-top: 1.5rem;
  }

  .top-frame {
    margin-bottom: 2rem; /* 枠の間の余白 */
  }

  /* .start (元の青い半透明枠スタイルを削除) */
  .start {
    /* 削除: background-color: rgba(214, 228, 255, 0.8); */
    color: #414170;
    /* 削除: border-radius: 12px; */
    /* 削除: box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08); */
    /* 削除: padding: 2rem; */
    /* 削除: margin-top: 1.5rem; */
    text-align: center;
    margin-bottom: 2.5rem;
  }

  /* .moon-card スタイル追加 (元のコードになかった) */
  .moon-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 2rem;
  }


  .moon-card .icon {
    font-size: 2rem;
    image-rendering: pixelated; /* 月の絵文字をドット絵風に */
  }

  footer {
    margin-top: 2rem;
    padding-top: 1rem;
    font-size: 0.85rem;
    color: #888;
  }
</style>
