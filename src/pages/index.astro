---
import Layout from '../layouts/Layout.astro';
---

<Layout title="チャートのホームページ">
  <h1>こんにちは、チャートです</h1>
  <p> ⋆⭒˚｡⋆ Welcome to my homepage ⋆⭒˚｡⋆</p>

  <div class="moon-card">
    <span class="icon" id="moon-icon">🌑</span>
    <h2>今夜の月は…<span id="moon-name">...</span></h2>
    <p id="moon-text">読み込み中...</p>
  </div>

  <!-- public/star.png を読み込む5本の流れ星 -->
  <div class="star-container" aria-hidden="true">
    <img src="/star.png" class="shooting-star star-1" alt="" />
    <img src="/star.png" class="shooting-star star-2" alt="" />
    <img src="/star.png" class="shooting-star star-3" alt="" />
    <img src="/star.png" class="shooting-star star-4" alt="" />
    <img src="/star.png" class="shooting-star star-5" alt="" />
  </div>
</Layout>

<script>
  function getMoonPhase(date = new Date()) {
    const cycle = 29.5305882;
    const knownNewMoon = new Date('2000-01-06T18:14:00Z');
    const diffDays = (date.getTime() - knownNewMoon.getTime()) / (1000 * 60 * 60 * 24);
    const phase = (diffDays % cycle) / cycle;
    return phase < 0 ? phase + 1 : phase;
  }

  function getMoonData(p: number) {
    if (p < 0.03 || p >= 0.97) return { name: '新月', icon: '🌑', text: '今日は新月です' };
    if (p < 0.22) return { name: '三日月！', icon: '🌒', text: '綺麗な三日月です' };
    if (p < 0.28) return { name: '上弦の月！', icon: '🌓', text: '今日は上弦の月！' };
    if (p < 0.47) return { name: '満月間近！', icon: '🌔', text: 'もう少しで満月です' };
    if (p < 0.53) return { name: '満月！', icon: '🌕', text: '今日は満月です！' };
    if (p < 0.72) return { name: '満月過ぎ！', icon: '🌖', text: '少しずつ欠けていきます' };
    if (p < 0.78) return { name: '下弦の月！', icon: '🌗', text: '今日は下弦の月！' };
    return { name: '有明の月！', icon: '🌘', text: '新月に近づいています' };
  }

  const phase = getMoonPhase();
  const moon = getMoonData(phase);

  const iconEl = document.getElementById('moon-icon');
  const nameEl = document.getElementById('moon-name');
  const textEl = document.getElementById('moon-text');

  if (iconEl) iconEl.textContent = moon.icon;
  if (nameEl) nameEl.textContent = moon.name;
  if (textEl) textEl.textContent = moon.text;
</script>

<style>
  .star-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
  }

  .shooting-star {
    position: absolute;
    width: 80px; /* 見やすい大きさに設定 */
    height: auto;
    opacity: 0;
    /* 1回だけ流れて消えた状態で止まる設定 */
    animation: meteor 1.8s ease-out 1 forwards;
  }

  /* 画面表示から少し時間（0.5s〜）を置いて順番に流れる設定 */
  .star-1 { top: -5%;  right: 10%; animation-delay: 0.5s; }
  .star-2 { top: 5%;   right: 30%; animation-delay: 0.8s; }
  .star-3 { top: 18%;  right: 5%;  animation-delay: 1.1s; }
  .star-4 { top: 30%;  right: 20%; animation-delay: 1.4s; }
  .star-5 { top: 40%;  right: 35%; animation-delay: 0.9s; }

  @keyframes meteor {
    0% {
      transform: translate(0, 0) rotate(-15deg);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      /* 先ほど成功した絵文字と同じ、画面内を斜めに横切る動き */
      transform: translate(-90vw, 85vh) rotate(-15deg);
      opacity: 0;
    }
  }
</style>